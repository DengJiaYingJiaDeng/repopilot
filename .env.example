# Only repositories below this directory can be indexed.
REPOPILOT_ALLOWED_ROOT=/absolute/path/to/your/workspace
REPOPILOT_MAX_FILE_BYTES=1000000
# Optional: none | local | openai
REPOPILOT_EMBEDDING_PROVIDER=none
# REPOPILOT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# REPOPILOT_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
# REPOPILOT_OPENAI_API_KEY=your_key_here
# REPOPILOT_INVESTIGATION_MODEL=your_responses_api_model
# REPOPILOT_INVESTIGATION_WORKFLOW=langgraph
# REPOPILOT_MAX_AGENT_CALLS=6
